<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" 
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package
      Name="Foldery"
      Language="1049"
      Version="1.0.0.0"
      Manufacturer="Foldery"
      UpgradeCode="{11111111-1111-1111-1111-111111111111}"
      InstallerVersion="500"
      Compressed="yes"
      Scope="perMachine">

    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />

    <MediaTemplate CabinetTemplate="data{0}.cab" CompressionLevel="high" />

    <Icon Id="FolderyIcon" SourceFile="icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="FolderyIcon" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Foldery" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="Foldery" />
    </StandardDirectory>

    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="MainExecutable" Guid="{22222222-2222-2222-2222-222222222222}">
        <File
            Id="FolderyExe"
            Name="Foldery.exe"
            Source="dist/Foldery.exe"
            KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="ApplicationProgramsFolder">
      <Component Id="StartMenuShortcut" Guid="{33333333-3333-3333-3333-333333333333}">
        <Shortcut
            Id="FolderyStartMenuShortcut"
            Name="Foldery"
            Target="[#FolderyExe]"
            WorkingDirectory="INSTALLFOLDER"
            Icon="FolderyIcon"
            IconIndex="0" />

        <RemoveFolder Id="RemoveProgramMenuFolder" On="uninstall" />
        <RegistryValue
            Root="HKCU"
            Key="Software\Foldery"
            Name="Installed"
            Type="integer"
            Value="1"
            KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <Feature Id="MainFeature" Title="Foldery" Level="1">
      <ComponentRef Id="MainExecutable" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>

  </Package>
</Wix>
